(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://api.sgetai.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
		-Server
	}
}

(geo_restrict) {
	@blocked_country expression `{http.request.header.CF-IPCountry} not in ["IN", "IE"]`
	respond @blocked_country "Access restricted to India and Ireland" 403
}

www.sgetai.com {
	redir https://sgetai.com{uri} permanent
}

sgetai.com {
	import geo_restrict
	import security_headers
	reverse_proxy nginx:8080
	lb_policy round_robin 
}

api.sgetai.com {
	import geo_restrict
	import security_headers
	reverse_proxy nginx:5001
}
