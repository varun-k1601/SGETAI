PORT=5001
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/getai
JWT_SECRET=replace_me_access_secret
JWT_REFRESH_SECRET=replace_me_refresh_secret
JWT_VERIFICATION_SECRET=replace_me_verification_secret
ADMIN_EMAIL=admin@getai.com
ADMIN_PASS=Admin@123
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=replace_me_supabase_service_role_key
SUPABASE_BUCKET=get-ai-uploads
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=replace_me_gmail_app_password
FRONTEND_URL=https://sgetai.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Both Google redirect URIs below must be registered VERBATIM under Authorized redirect URIs on
# the OAuth client named by GOOGLE_OAUTH_CLIENT_ID. Google compares them character for character:
# 127.0.0.1 vs localhost, a trailing slash, http vs https or a different port are all different
# URIs and all produce Error 400: redirect_uri_mismatch. Neither has a fallback -- if one is unset
# that flow fails with a 503 naming the variable, which is the honest outcome. They are separate
# on purpose: signing in must never ask for calendar access.
GOOGLE_OAUTH_REDIRECT_URI=https://api.sgetai.com/api/auth/oauth/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=https://api.sgetai.com/api/recruiter/calendar/callback
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=https://api.sgetai.com/api/auth/oauth/microsoft/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://api.sgetai.com/api/pro/linkedin/callback
CAREER_AGENT_MESSAGE_TTL_DAYS=60
CAREER_AGENT_MAX_MESSAGES_PER_USER=40
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PDFLATEX_PATH=
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_ANALYSIS_MODEL=qwen2.5:7b

# TIMEOUT LADDER for the career agent. Each rung MUST be strictly shorter than the one wrapping it,
# so the innermost fires first and the user gets a real error instead of a dead socket:
#
#   CAREER_AGENT_GEMINI_TIMEOUT_MS   45000   per Gemini attempt
#   OLLAMA_TIMEOUT_MS               100000   per Ollama attempt
#   CAREER_AGENT_TOTAL_BUDGET_MS    120000   total across ALL providers and attempts
#   nginx proxy_read_timeout        150000   nginx.conf, backend server block
#   frontend DEFAULT_TIMEOUT_MS     180000   frontend/src/services/api.js
#
# If you raise the backend budget above nginx's read timeout, nginx cuts the connection first and
# its 504 carries no CORS headers - which the browser reports as an unreadable "Failed to fetch".
OLLAMA_TIMEOUT_MS=100000
# Reply length for the local fallback model. Must be small enough to FINISH inside
# OLLAMA_TIMEOUT_MS on your hardware - on CPU-only boxes 1400 tokens takes ~135s and never lands.
CAREER_AGENT_OLLAMA_NUM_PREDICT=350
# Resume parsing / match analysis ask for many more tokens than a chat reply, so they get their
# own ceiling. Still below nginx proxy_read_timeout, because they are request paths too.
OLLAMA_ANALYSIS_TIMEOUT_MS=140000
CAREER_AGENT_GEMINI_TIMEOUT_MS=45000
CAREER_AGENT_TOTAL_BUDGET_MS=120000
CAREER_AGENT_MIN_PROVIDER_SLICE_MS=12000
